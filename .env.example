# Path to the Website B config. Defaults to config/site-b.json
# SITE_B_CONFIG=config/site-b.json

# Port for the local test page + WebSocket. Defaults to 3000
# PORT=3000

# Only for automated container testing. Leave unset on your machine: the browser must be visible.
# HEADLESS=1

# Use a specific Chromium binary instead of the one Playwright installed.
# CHROMIUM_PATH=/path/to/chrome

# ---- profile pool ----
# Where the SQLite database and the dev master key live. Defaults to ./data
# DATA_DIR=data
# 32-byte base64 master key for storageState encryption. Generated into DATA_DIR/master.key when unset (dev only).
# PROFILE_MASTER_KEY=
# MAX_WORKFLOWS=5
# COOLDOWN_MS=60000
# IDLE_TIMEOUT_MS=600000
# LEASE_MS=30000
# QUEUE_TIMEOUT_MS=60000
# MAX_REASSIGN=2

# ---- applicant sessions ----
# Set to 1 when the applicant site is served over HTTPS so the session cookie gets the Secure flag.
# SECURE_COOKIES=0
# SESSION_TTL_DAYS=30
# After Website B is READY, an applicant workflow is submitted once every seeded field is acknowledged,
# or after this many ms at the latest (the submit steps reconcile whatever is left).
# APPLICANT_SUBMIT_FALLBACK_MS=20000

# ---- development ----
# Failure artifacts (screenshots, sanitized HTML, JSON) under DATA_DIR/debug/failures when a step fails. 0 disables.
# FAILURE_ARTIFACTS=1
# The automation browser mode chosen on /debug is kept in DATA_DIR/dev-settings.json and wins over HEADLESS at start.

# ---- proxy egress ----
# Active health probe interval for proxy sessions (0 disables) and the URL probed through each proxy (default: Website B base URL).
# EGRESS_CHECK_INTERVAL_MS=60000
# EGRESS_CHECK_URL=
# Launch-time proxy preflight: attempts (3 = the health "down" threshold) and per-attempt timeout.
# EGRESS_PREFLIGHT_ATTEMPTS=3
# EGRESS_PREFLIGHT_TIMEOUT_MS=8000
# Development network diagnostics (POST /api/dev/network-diagnostics/:accountId): URL that echoes the public IP, fetched through the account's proxy.
# DIAG_IP_URL=https://api.ipify.org?format=json
# (CHROMIUM_PROXY_MODE is obsolete: every account browser is its own Chromium process with its own proxy.)

# ---- client isolation: one account = one persistent browser profile = one proxy ----
# Account browsers only ever use their assigned proxy; Direct (server IP) is never assigned to an account and never a
# fallback. Default: on as soon as at least one proxy is imported (and always in production); off only while no proxy
# exists, when accounts WITHOUT a proxy go direct. Set 0/1 to decide explicitly.
# STRICT_ACCOUNT_EGRESS=1
# Permanent Chromium user data directories, one per account (profile-<id>/, mode 0700), relative to DATA_DIR unless absolute.
# BROWSER_PROFILE_DIR=browser-profiles
# Runtime lock files (outside the Chromium directories).
# PROFILE_LOCK_DIR=locks
# A profile runtime whose heartbeat is older than this may be reclaimed, and only when its owner process is provably gone.
# PROFILE_RUNTIME_LEASE_MS=90000
# Automatic clean-proxy replacements allowed while launching one account browser (0 disables automatic failover).
# MAX_AUTO_EGRESS_FAILOVERS_PER_LAUNCH=1
# Default browser environment for accounts without an explicit one (set per account on the accounts API). Unset = system.
# BROWSER_DEFAULT_LOCALE=en-US
# BROWSER_DEFAULT_TIMEZONE=America/New_York

# ---- VPS / private deployment ----
# NODE_ENV=production: PROFILE_MASTER_KEY is required (no dev key file), STRICT_ACCOUNT_EGRESS defaults on, and
# ADMIN_PASSWORD is required unless SERVICE_HOST is loopback.
# NODE_ENV=production
# Interface to bind (default loopback). Expose the dashboard only through a VPN / private network + TLS reverse proxy.
# SERVICE_HOST=127.0.0.1
# Reverse proxies whose X-Forwarded-For / X-Real-IP are trusted (comma-separated IPs). Unset: forwarding headers are never trusted.
# TRUSTED_PROXIES=
# ADMIN_PASSWORD=
# ADMIN_SESSION_HOURS=12
