# Path to the Website B config. Defaults to config/site-b.json
# SITE_B_CONFIG=config/site-b.json

# Port for the local test page + WebSocket. Defaults to 3000
# PORT=3000

# Only for automated container testing. Leave unset on your machine: the browser must be visible.
# HEADLESS=1

# Use a specific Chromium binary instead of the one Playwright installed.
# CHROMIUM_PATH=/path/to/chrome

# ---- profile pool ----
# Where the SQLite database and the dev master key live. Defaults to ./data
# DATA_DIR=data
# 32-byte base64 master key for storageState encryption. Generated into DATA_DIR/master.key when unset (dev only).
# PROFILE_MASTER_KEY=
# MAX_WORKFLOWS=5
# COOLDOWN_MS=60000
# IDLE_TIMEOUT_MS=600000
# LEASE_MS=30000
# QUEUE_TIMEOUT_MS=60000
# MAX_REASSIGN=2

# ---- applicant sessions ----
# Set to 1 when the applicant site is served over HTTPS so the session cookie gets the Secure flag.
# SECURE_COOKIES=0
# SESSION_TTL_DAYS=30
# After Website B is READY, an applicant workflow is submitted once every seeded field is acknowledged,
# or after this many ms at the latest (the submit steps reconcile whatever is left).
# APPLICANT_SUBMIT_FALLBACK_MS=20000
