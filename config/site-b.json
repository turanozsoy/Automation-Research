{
  "baseUrl": "https://domainname.com",
  "targetUrl": "https://domainname.com/",
  "loginPathPattern": "^/login(/|$)",
  "recommendedLink": "a:has-text(\"Recommended\")",
  "fields": {
    "firstName": {
      "selector": "#first-name",
      "kind": "text"
    },
    "lastName": {
      "selector": "#last-name",
      "kind": "text"
    },
    "dateOfBirth": {
      "selector": "#date-of-birth",
      "kind": "text",
      "format": "MM/DD/YYYY"
    },
    "mobileNumber": {
      "selector": "#mobile-number",
      "kind": "text"
    },
    "address1": {
      "selector": "input[name=\"line1\"]",
      "kind": "text",
      "syncMode": "deferred",
      "inputMethod": "type"
    },
    "city": {
      "selector": "input[name=\"city\"]",
      "kind": "text",
      "requiredAtStart": false,
      "syncMode": "deferred"
    },
    "state": {
      "selector": "select[name=\"state\"]",
      "kind": "select",
      "requiredAtStart": false,
      "syncMode": "deferred"
    },
    "zip": {
      "selector": "input[name=\"zip\"]",
      "kind": "text",
      "requiredAtStart": false,
      "syncMode": "deferred"
    },
    "authenticationCode": {
      "selector": [
        "input[placeholder=\"•••-••-••••\"]",
        "#test-authentification-code"
      ],
      "kind": "text",
      "writeOnly": true
    }
  },
  "submitButton": "button[type=\"submit\"]",
  "addressSearch": {
    "field": "address1",
    "order": [
      "address1",
      "state",
      "city",
      "zip"
    ],
    "separator": ", ",
    "stateAs": "name",
    "suggestionsWaitMs": 1500,
    "settleMs": 150,
    "keySequences": [
      [
        "ArrowDown",
        "Enter"
      ],
      [
        "Enter"
      ]
    ],
    "keyDelayMs": 100,
    "revealFields": [
      "state"
    ],
    "revealTimeoutMs": 6000,
    "dependentFields": [],
    "retries": 1,
    "enterWithoutList": true
  },
  "checkout": {
    "frameUrlIncludes": "",
    "agreeButton": "button[aria-label=\"Agree and continue\"]",
    "toggle": "#v-0-0-0-0-0-0",
    "primaryButton": "button[data-variant=\"primary\"]",
    "secondaryButton": "button:has-text(\"Continue on phone\")"
  },
  "generatedUrl": {
    "prefix": "https://secondsubdomain.com/test/it-worked/",
    "pattern": "^https://secondsubdomain\\.com/test/it-worked/[^/?#\\s]+",
    "watchNavigationRequests": true,
    "anchorPollMs": 250
  },
  "timeouts": {
    "pageLoad": 60000,
    "action": 10000,
    "iframe": 30000,
    "checkoutStep": 30000,
    "generatedUrl": 30000
  },
  "debounceMs": 150
}
