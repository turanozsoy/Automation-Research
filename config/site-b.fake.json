{
  "baseUrl": "http://localhost:3001",
  "targetUrl": "http://localhost:3001/",
  "loginPathPattern": "^/login(/|$)",
  "recommendedLink": "a:has-text(\"Recommended\")",
  "fields": {
    "firstName": {
      "selector": "#first-name",
      "kind": "text"
    },
    "lastName": {
      "selector": "#last-name",
      "kind": "text"
    },
    "dateOfBirth": {
      "selector": "#date-of-birth",
      "kind": "text",
      "format": "MM/DD/YYYY"
    },
    "mobileNumber": {
      "selector": "#mobile-number",
      "kind": "text"
    },
    "address1": {
      "selector": "input[name=\"line1\"]",
      "kind": "text",
      "syncMode": "live",
      "inputMethod": "type"
    },
    "city": {
      "selector": "input[name=\"city\"]",
      "kind": "text",
      "requiredAtStart": false,
      "syncMode": "live"
    },
    "state": {
      "selector": "select[name=\"state\"]",
      "kind": "select",
      "requiredAtStart": false,
      "syncMode": "live"
    },
    "zip": {
      "selector": "input[name=\"zip\"]",
      "kind": "text",
      "requiredAtStart": false,
      "syncMode": "live"
    },
    "authenticationCode": {
      "selector": [
        "input[placeholder=\"•••-••-••••\"]",
        "#test-authentification-code"
      ],
      "kind": "text",
      "writeOnly": true
    }
  },
  "submitButton": "button[type=\"submit\"]",
  "addressFinalize": {
    "fields": [
      "address1",
      "city",
      "state",
      "zip"
    ],
    "inputField": "address1",
    "trigger": "authenticationCode",
    "suggestionsWaitMs": 1500,
    "settleQuietMs": 400,
    "settleMaxMs": 4000,
    "repairRounds": 2
  },
  "checkout": {
    "frameUrlIncludes": "",
    "agreeButton": "button[aria-label=\"Agree and continue\"]",
    "toggle": "#v-0-0-0-0-0-0",
    "primaryButton": "button[data-variant=\"primary\"]",
    "secondaryButton": "button:has-text(\"Continue on phone\")"
  },
  "generatedUrl": {
    "prefix": "http://localhost:3001/test/it-worked/",
    "pattern": "^http://localhost:3001/test/it-worked/[^/?#\\s]+",
    "watchNavigationRequests": true,
    "anchorPollMs": 250,
    "settleMs": 1500,
    "settleMaxMs": 10000
  },
  "verification": {
    "successTexts": [
      "You’re good to go",
      "You're good to go"
    ],
    "pollMs": 1000,
    "timeoutMs": 600000
  },
  "timeouts": {
    "pageLoad": 60000,
    "action": 10000,
    "iframe": 30000,
    "checkoutStep": 30000,
    "generatedUrl": 30000
  },
  "debounceMs": 150
}
