# /etc/shipzora/service.env  (owner root, mode 0600). Edit, then: sudo systemctl restart shipzora
NODE_ENV=production
PORT=3000
SERVICE_HOST=127.0.0.1
TRUSTED_PROXIES=127.0.0.1
SECURE_COOKIES=1
DATA_DIR=/var/lib/shipzora
HEADLESS=1
DISPLAY=:99
PLAYWRIGHT_BROWSERS_PATH=/opt/shipzora/pw-browsers

# generated by deploy/install.sh (keep them; losing PROFILE_MASTER_KEY loses every saved session)
PROFILE_MASTER_KEY=
ADMIN_PASSWORD=

# Meta Pixel (same id as the old site) and the Conversions API token from Events Manager
META_PIXEL_ID=
META_CAPI_TOKEN=
# Events Manager "Test events" code while you check the first events; remove afterwards
# META_TEST_EVENT_CODE=
PIXEL_LEAD_STEP=dob

# capacity: one Chromium per live applicant, about 500 MB each
MAX_WORKFLOWS=6
# timers (milliseconds)
APPLICANT_LEAVE_GRACE_MS=90000
IDLE_TIMEOUT_MS=600000
EGRESS_CHECK_TIMEOUT_MS=15000
EGRESS_PREFLIGHT_TIMEOUT_MS=15000
